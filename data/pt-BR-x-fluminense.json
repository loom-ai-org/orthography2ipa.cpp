  "allophone_rules": [
    {
      "id": "FLU_CHIADO_CODA_S",
      "phonemes": [
        "s"
      ],
      "surface": "ʃ",
      "syllable_position": "coda",
      "notes": "Prestige Fluminense shares the Carioca coda-/S/ palatalisation [ʃ] (Callou 2010:135, whose NURC Rio data is the coastal-Fluminense norm). Encoded as the default; the chiado is a gradient across the state - less consistent in the rural/northern interior, where an inland tap-rhotic caipira-influenced substratum coexists (documented in notes, not modelled as a separate value)."
    },
    {
      "id": "FLU_CHIADO_CODA_Z",
      "phonemes": [
        "z"
      ],
      "surface": "ʒ",
      "syllable_position": "coda",
      "notes": "Voiced counterpart: coda /z/ -> [ʒ] before a voiced consonant (Callou 2010:135)."
    },
    {
      "id": "FLU_CODA_R_FINAL",
      "phonemes": [
